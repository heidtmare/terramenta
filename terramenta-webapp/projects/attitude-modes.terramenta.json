{
  "$schema": "../schema/project.schema.json",
  "terramenta": 3,
  "name": "Attitude modes",
  "description": "Three pointing laws over six hours. `observer` (500 km, 51.6°): +Z nadir, +X velocity (LVLH), star tracker sun angle. `tracker` (SSO 700 km): +Z on Svalbard with −Y as close to the Sun as that allows; off-nadir and array sun angles. `spinner` (1200 km, 30°): inertial hold spinning 6°/s about +Z. Body axes drawn X red, Y green, Z blue; sensor boresights in their colours. Charts, min/max and AEM export in Spacecraft → Attitude.",
  "ui": { "tab": "spacecraft" },
  "frame": "ecef",
  "clock": { "epoch": "2026-03-20T00:00:00Z", "timeScale": 20, "paused": false },
  "camera": { "lat": 40, "lon": 0, "altitudeKm": 12000 },
  "spacecraft": [
    {
      "id": "observer",
      "label": "Observer · LVLH",
      "pointColor": "#ffb86b",
      "lineColor": "#ffb86ba6",
      "leadingOrbits": 0,
      "trailingOrbits": 0.5,
      "propagation": {
        "name": "OBSERVER",
        "initial": {
          "epoch": "2026-03-20T00:00:00Z",
          "positionKm": [6878.137, 0, 0],
          "velocityKmS": [0, 4.728555, 5.965951]
        },
        "durationS": 21600,
        "stepS": 60,
        "vehicle": { "massKg": 500, "dragAreaM2": 4, "srpAreaM2": 4 },
        "forces": { "gravity": [4, 4], "drag": "harrisPriester" }
      }
    },
    {
      "id": "tracker",
      "label": "Tracker · Svalbard",
      "pointColor": "#7affea",
      "lineColor": "#7affeaa6",
      "leadingOrbits": 0,
      "trailingOrbits": 0.5,
      "propagation": {
        "name": "TRACKER",
        "initial": {
          "epoch": "2026-03-20T00:00:00Z",
          "positionKm": [7078.137, 0, 0],
          "velocityKmS": [0, -1.069032, 7.427751]
        },
        "durationS": 21600,
        "stepS": 60,
        "vehicle": { "massKg": 500, "dragAreaM2": 4, "srpAreaM2": 4 },
        "forces": { "gravity": [4, 4], "drag": "harrisPriester" }
      }
    },
    {
      "id": "spinner",
      "label": "Spinner · 6°/s",
      "pointColor": "#ff8fa3",
      "lineColor": "#ff8fa3a6",
      "leadingOrbits": 0,
      "trailingOrbits": 0.5,
      "propagation": {
        "name": "SPINNER",
        "initial": {
          "epoch": "2026-03-20T00:00:00Z",
          "positionKm": [7578.137, 0, 0],
          "velocityKmS": [0, 6.280848, 3.626249]
        },
        "durationS": 21600,
        "stepS": 60,
        "vehicle": { "massKg": 500, "dragAreaM2": 4, "srpAreaM2": 4 },
        "forces": { "gravity": [4, 4], "drag": "harrisPriester" }
      }
    }
  ],
  "groundStations": [
    { "id": "svalbard", "label": "Svalbard", "latDeg": 78.2297, "lonDeg": 15.4078, "altKm": 0.5, "minElevationDeg": 5 }
  ],
  "attitudes": [
    {
      "spacecraft": "observer",
      "label": "Nadir, velocity",
      "primary": { "body": [0, 0, 1], "to": "nadir" },
      "secondary": { "body": [1, 0, 0], "to": "velocity" },
      "sensors": [
        { "label": "Camera", "body": [0, 0, 1], "to": "nadir", "color": "#ffcc33" },
        { "label": "Star tracker → Sun", "body": [0, -0.5, -0.866025], "to": "sun", "color": "#d68bff" }
      ],
      "stepS": 30
    },
    {
      "spacecraft": "tracker",
      "label": "Svalbard tracking, sun-constrained",
      "primary": { "body": [0, 0, 1], "to": "target" },
      "secondary": { "body": [0, -1, 0], "to": "sun" },
      "station": "svalbard",
      "sensors": [
        { "label": "Off-nadir", "body": [0, 0, 1], "to": "nadir", "color": "#ffcc33" },
        { "label": "Array → Sun", "body": [0, -1, 0], "to": "sun", "color": "#6bd6ff", "draw": false }
      ],
      "stepS": 30
    },
    {
      "spacecraft": "spinner",
      "label": "Spin-stabilised",
      "quaternion": [0, 0, 0, 1],
      "spin": { "axis": [0, 0, 1], "rateDegS": 6 },
      "sensors": [{ "label": "+X → Sun", "body": [1, 0, 0], "to": "sun", "color": "#ffcc33", "draw": false }],
      "stepS": 10
    }
  ],
  "timeline": {
    "events": [{ "id": "hold", "label": "Hold at end", "at": { "event": "observer.end" }, "actions": { "paused": true } }]
  }
}
