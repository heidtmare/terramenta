{
  "$schema": "../schema/project.schema.json",
  "terramenta": 3,
  "name": "LEO Hohmann transfer",
  "description": "500 → 800 km Hohmann transfer against a coasting reference, Cowell-propagated with EGM2008 8×8, Harris-Priester drag, Sun/Moon and SRP. The timeline slows the clock around each burn. Both start with the same 1σ state uncertainty (RSW), propagated linearly and drawn as 3σ position ellipsoids. Reports plots altitude, SMA, eccentricity and 1σ in-track with a Δv budget; export CSV/CZML there, OEM (with covariance)/SPK from the Spacecraft tab.",
  "ui": { "tab": "analysis" },
  "frame": "eci",
  "clock": { "epoch": "2026-01-01T00:20:00Z", "timeScale": 60, "paused": false },
  "camera": { "lat": 20, "lon": -40, "altitudeKm": 30000 },
  "environment": {
    "eop": "https://celestrak.org/SpaceData/EOP-All.csv",
    "spaceWeather": "https://celestrak.org/SpaceData/SW-All.csv"
  },
  "spacecraft": [
    {
      "id": "reference",
      "label": "Reference · 500 km coast",
      "pointColor": "#8ce0ff",
      "lineColor": "#8ce0ffa6",
      "leadingOrbits": 0,
      "trailingOrbits": 1,
      "trailPath": "orbit",
      "propagation": {
        "name": "REFERENCE",
        "initial": {
          "epoch": "2026-01-01T00:00:00Z",
          "positionKm": [6878.137, 0, 0],
          "velocityKmS": [0, 4.728554669, 5.965951219]
        },
        "durationS": 21600,
        "stepS": 30,
        "vehicle": { "massKg": 500, "dragAreaM2": 4, "srpAreaM2": 4 },
        "forces": { "gravity": [8, 8], "drag": "harrisPriester" },
        "covariance": {
          "positionSigmaKm": [0.05, 0.2, 0.03],
          "velocitySigmaKmS": [0.0002, 0.00005, 0.00003],
          "processNoiseKm2S3": [1e-13, 1e-13, 1e-13]
        }
      }
    },
    {
      "id": "transfer",
      "label": "Transfer · 500 → 800 km",
      "pointColor": "#ffb86b",
      "lineColor": "#ffb86ba6",
      "leadingOrbits": 0,
      "trailingOrbits": 1,
      "trailPath": "orbit",
      "propagation": {
        "name": "TRANSFER",
        "initial": {
          "epoch": "2026-01-01T00:00:00Z",
          "positionKm": [6878.137, 0, 0],
          "velocityKmS": [0, 4.728554669, 5.965951219]
        },
        "durationS": 21600,
        "stepS": 30,
        "vehicle": { "massKg": 500, "dryMassKg": 400, "dragAreaM2": 4, "srpAreaM2": 4 },
        "forces": { "gravity": [8, 8], "drag": "harrisPriester" },
        "maneuvers": [
          { "epoch": "2026-01-01T00:30:00Z", "deltaVKmS": [0.080808, 0, 0], "frame": "vnb", "ispS": 300 },
          { "epoch": "2026-01-01T01:18:51.847Z", "deltaVKmS": [0.07995, 0, 0], "frame": "vnb", "ispS": 300 }
        ],
        "covariance": {
          "positionSigmaKm": [0.05, 0.2, 0.03],
          "velocitySigmaKmS": [0.0002, 0.00005, 0.00003],
          "processNoiseKm2S3": [1e-13, 1e-13, 1e-13]
        }
      }
    }
  ],
  "timeline": {
    "events": [
      { "id": "burn1-approach", "label": "Slow for burn 1", "at": { "event": "transfer.burn1", "offsetS": -300 }, "actions": { "timeScale": 10 } },
      { "id": "transfer-coast", "label": "Transfer coast", "at": { "event": "transfer.burn1", "offsetS": 120 }, "actions": { "timeScale": 60 } },
      { "id": "burn2-approach", "label": "Slow for burn 2", "at": { "event": "transfer.burn2", "offsetS": -300 }, "actions": { "timeScale": 10 } },
      { "id": "final-orbit", "label": "Final orbit", "at": { "event": "transfer.burn2", "offsetS": 120 }, "actions": { "timeScale": 120 } },
      { "id": "hold", "label": "Hold at end", "at": { "event": "transfer.end" }, "actions": { "paused": true } }
    ]
  },
  "analysis": {
    "plots": [
      { "id": "altitude", "quantity": "altitudeKm", "spacecraft": ["reference", "transfer"] },
      { "id": "sma", "quantity": "smaKm", "spacecraft": ["reference", "transfer"] },
      { "id": "eccentricity", "quantity": "eccentricity", "spacecraft": ["transfer"] },
      { "id": "in-track", "quantity": "sigmaInTrackM", "spacecraft": ["reference", "transfer"] }
    ]
  }
}
