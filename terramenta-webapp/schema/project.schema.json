{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terramenta project",
  "description": "*.terramenta.json, format version 3. Omitted fields keep fresh-globe defaults. Relative URLs resolve against the app root. Cross-references (ids, mission names, stop/durationS) are checked by src/project.js.",
  "type": "object",
  "required": ["terramenta"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "terramenta": { "const": 3, "description": "Format version." },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": { "enum": ["full", "flight"] },
        "tab": {
          "enum": ["project", "layers", "spacecraft", "timeline", "analysis", "view"]
        },
        "readout": { "type": "boolean" },
        "collapsed": { "type": "boolean" }
      }
    },
    "view": { "enum": ["globe", "heliocentric"] },
    "frame": { "enum": ["ecef", "eci"] },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": { "anyOf": [{"const": "now"}, {"type": "string", "format": "date-time"}] },
        "timeScale": { "type": "number" },
        "paused": { "type": "boolean" },
        "shaded": { "type": "boolean" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "description": "lat and lon go together; follow and anchor are exclusive.",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number" },
        "altitudeKm": { "type": "number", "exclusiveMinimum": 0 },
        "follow": { "type": "string", "description": "Mission id." },
        "anchor": { "enum": ["sun", "earth", "mars", "barycenter"] }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": {"type": "boolean"}, "layer": {"$ref": "#/$defs/preset"} }
    },
    "vectorTiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "layer": { "$ref": "#/$defs/preset" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "picking": { "type": "boolean" },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/overlayLayer"} }
      }
    },
    "ephemerides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/ephemerisLayer"} }
      }
    },
    "environment": {
      "description": "Propagation data, by URL. Loaded once per session; see src/environment.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eop": { "type": "string", "description": "IERS finals2000A.all or CelesTrak EOP-All.csv." },
        "spaceWeather": {
          "type": "string",
          "description": "CelesTrak SW-All.csv; needed by drag nrlmsise00."
        },
        "kernel": {
          "type": "string",
          "description": "SPK/PCK, e.g. de440s.bsp; Sun/Moon third body."
        }
      }
    },
    "spacecraft": {
      "description": "Numerically propagated spacecraft, drawn as ephemeris layers.",
      "type": "array",
      "items": { "$ref": "#/$defs/spacecraft" }
    },
    "missions": { "type": "array", "items": {"$ref": "#/$defs/mission"} },
    "placemarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": {"type": "boolean"} }
    },
    "gnc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "eciAxes": { "type": "boolean" },
        "ecefAxes": { "type": "boolean" },
        "graticule": { "type": "boolean" },
        "graticuleStepDeg": { "type": "number", "exclusiveMinimum": 0 },
        "sidereal": { "type": "boolean" },
        "track": { "type": "boolean" },
        "trackOrbits": { "type": "number", "minimum": 0 },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "noradId"],
          "properties": {
            "layer": { "type": "string", "description": "Ephemeris layer id." },
            "noradId": { "type": "integer" }
          }
        }
      }
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "visible": {"type": "boolean"}, "help": {"type": "boolean"} }
    },
    "keyboard": { "type": "boolean" },
    "director": { "$ref": "#/$defs/director" },
    "timeline": { "$ref": "#/$defs/timeline" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "groundStations": {
      "description": "Sites contacts are searched from; see src/events.js.",
      "type": "array",
      "items": { "$ref": "#/$defs/groundStation" }
    },
    "events": {
      "description": "Event searches per spacecraft; contacts with every ground station always. See src/events.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eclipses": { "type": "boolean", "description": "Earth umbra/penumbra (conical); default true." },
        "apsides": { "type": "boolean", "description": "Default false." },
        "nodes": { "type": "boolean", "description": "GCRF equator crossings; default false." },
        "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Bracketing grid, s; spans shorter than this may be missed. Default 30." }
      }
    },
    "targets": {
      "description": "Differential-correction problems on spacecraft burns (Spacecraft tab); see src/targeting.js.",
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    },
    "attitudes": {
      "description": "Attitude profile per spacecraft (Spacecraft tab); see src/attitude.js.",
      "type": "array",
      "items": { "$ref": "#/$defs/attitude" }
    }
  },
  "$defs": {
    "color": {
      "title": "a hex colour (#rgb, #rgba, #rrggbb, #rrggbbaa)",
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "preset": {
      "description": "Preset label or index.",
      "anyOf": [{"type": "string"}, {"type": "integer", "minimum": 0}]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "refreshSeconds": {
      "description": "Re-fetch period; null: never.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "overlayLayer": {
      "description": "GeoJSON. Exactly one of url and text.",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "refreshSeconds": { "$ref": "#/$defs/refreshSeconds" },
        "visible": { "type": "boolean" },
        "simpleStyle": { "type": "boolean" },
        "altitudeMode": { "enum": ["relativeToSurface", "clampToSurface"] },
        "altitudeScale": { "type": "number" },
        "extrude": { "type": "boolean" },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "ephemerisLayer": {
      "description": "OMM JSON or KVN OEM. Exactly one of url and text.",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "refreshSeconds": { "$ref": "#/$defs/refreshSeconds" },
        "visible": { "type": "boolean" },
        "select": {
          "description": "NORAD ids drawn; null or omitted: all.",
          "type": ["array", "null"],
          "items": { "type": "integer" }
        },
        "trails": { "type": "boolean" },
        "leadingOrbits": { "type": "number", "minimum": 0 },
        "trailingOrbits": { "type": "number", "minimum": 0 },
        "trailSamples": { "type": "integer", "minimum": 0 },
        "trailPath": { "enum": ["track", "orbit"] },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "mission": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "departureSearchDays": { "type": "number", "exclusiveMinimum": 0 },
        "arrivalSearchStartDays": { "type": "number", "minimum": 0 },
        "arrivalSearchEndDays": { "type": "number", "exclusiveMinimum": 0 },
        "searchSteps": { "type": "integer", "minimum": 1 },
        "parkingAltitudeKm": { "type": "number", "minimum": 0 }
      }
    },
    "groundStation": {
      "type": "object",
      "required": ["id", "latDeg", "lonDeg"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "letters, digits, - and _" },
        "label": { "type": "string" },
        "latDeg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Geodetic, WGS 84." },
        "lonDeg": { "type": "number", "minimum": -180, "maximum": 360 },
        "altKm": { "type": "number", "description": "Above the ellipsoid; default 0." },
        "minElevationDeg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Mask; default 0." },
        "horizon": {
          "description": "Terrain mask [azimuthDeg, elevationDeg], azimuth ascending in [0, 360); linear between, wrapping.",
          "type": "array",
          "items": {
            "title": "[azimuthDeg, elevationDeg]",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": -90, "maximum": 360 }
          }
        },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "spacecraft", "variables", "goals"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "letters, digits, - and _" },
        "label": { "type": "string" },
        "spacecraft": { "type": "string", "description": "Spacecraft id; its propagation's burns are varied." },
        "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/targetVariable" } },
        "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/targetGoal" } },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 200, "description": "Default 25." }
      }
    },
    "targetVariable": {
      "type": "object",
      "required": ["parameter"],
      "additionalProperties": false,
      "properties": {
        "burn": { "type": "integer", "minimum": 1, "description": "Impulsive burn, 1-based." },
        "finite": { "type": "integer", "minimum": 1, "description": "Finite burn, 1-based." },
        "parameter": { "type": "string", "enum": ["dv1", "dv2", "dv3", "epoch", "start", "duration"] },
        "perturbation": { "type": "number", "exclusiveMinimum": 0, "description": "Finite-difference step and scale; default 1e-5 km/s or 1 s." },
        "maxStep": { "type": "number", "exclusiveMinimum": 0, "description": "Largest change per iteration; default 0.1 km/s or 600 s." }
      },
      "if": { "required": ["burn"] },
      "then": {
        "properties": { "parameter": { "enum": ["dv1", "dv2", "dv3", "epoch"] } }
      },
      "else": {
        "required": ["finite"],
        "properties": { "parameter": { "enum": ["start", "duration"] } }
      }
    },
    "targetGoal": {
      "type": "object",
      "required": ["quantity", "at", "value", "tolerance"],
      "additionalProperties": false,
      "properties": {
        "quantity": { "$ref": "#/$defs/quantity" },
        "at": {
          "type": "string",
          "pattern": "^(end|burn[1-9]\\d*(\\.before)?|finite[1-9]\\d*(\\.end)?|\\d{4}-\\d{2}-\\d{2}T[0-9:.]+Z?)$",
          "title": "end, burnN, burnN.before, finiteN, finiteN.end or a UTC epoch"
        },
        "value": { "type": "number" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "vec3": {
      "title": "three numbers",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "direction": {
      "anyOf": [
        { "type": "string", "enum": ["nadir", "zenith", "velocity", "antiVelocity", "orbitNormal", "antiOrbitNormal", "sun", "antiSun", "target"] },
        { "$ref": "#/$defs/vec3", "description": "GCRF vector." }
      ]
    },
    "pointing": {
      "type": "object",
      "required": ["body", "to"],
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/vec3", "description": "Body axis." },
        "to": { "$ref": "#/$defs/direction" }
      }
    },
    "attitude": {
      "type": "object",
      "required": ["spacecraft"],
      "additionalProperties": false,
      "properties": {
        "spacecraft": { "type": "string", "description": "Spacecraft id; one profile each." },
        "label": { "type": "string" },
        "quaternion": {
          "title": "four numbers",
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "Body → GCRF [x, y, z, w], held. Instead of primary/secondary."
        },
        "primary": { "$ref": "#/$defs/pointing", "description": "Body axis held exactly on its direction." },
        "secondary": { "$ref": "#/$defs/pointing", "description": "Body axis brought as close to its direction as the primary allows." },
        "spin": {
          "type": "object",
          "required": ["axis", "rateDegS"],
          "additionalProperties": false,
          "properties": {
            "axis": { "$ref": "#/$defs/vec3", "description": "Body axis." },
            "rateDegS": { "type": "number" },
            "epoch": { "type": "string", "format": "date-time", "description": "Zero angle; default the propagation start." }
          }
        },
        "station": { "type": "string", "description": "Ground station id for direction \"target\"." },
        "target": {
          "type": "object",
          "required": ["latDeg", "lonDeg"],
          "additionalProperties": false,
          "description": "Site for direction \"target\", instead of station.",
          "properties": {
            "latDeg": { "type": "number", "minimum": -90, "maximum": 90 },
            "lonDeg": { "type": "number", "minimum": -180, "maximum": 360 },
            "altKm": { "type": "number" }
          }
        },
        "sensors": { "type": "array", "items": { "$ref": "#/$defs/sensor" } },
        "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Sample step, s; default 60." },
        "axes": { "type": "boolean", "description": "Draw body axes; default true." }
      },
      "if": { "required": ["quaternion"] },
      "else": { "required": ["primary", "secondary"] }
    },
    "sensor": {
      "description": "Body axis: its angle to `to` is reported; drawn as a boresight, with its footprint when it has a field of view.",
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "body": { "$ref": "#/$defs/vec3" },
        "to": { "$ref": "#/$defs/direction" },
        "color": { "$ref": "#/$defs/color" },
        "draw": { "type": "boolean", "description": "Draw the boresight and footprint; default true." },
        "fov": { "$ref": "#/$defs/fov" }
      }
    },
    "fov": {
      "title": "{halfAngleDeg} or {halfXDeg, halfYDeg, reference?}",
      "anyOf": [
        {
          "type": "object",
          "required": ["halfAngleDeg"],
          "additionalProperties": false,
          "properties": { "halfAngleDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 } }
        },
        {
          "type": "object",
          "required": ["halfXDeg", "halfYDeg"],
          "additionalProperties": false,
          "properties": {
            "halfXDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 },
            "halfYDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 },
            "reference": { "$ref": "#/$defs/vec3", "description": "Body axis the width (halfXDeg) lies along." }
          }
        }
      ]
    },
    "analysis": {
      "description": "Saved plots, porkchop, coverage, conjunction and orbit determination studies (Analysis tab); see src/analysis.js, src/coverage.js, src/conjunction.js, src/od.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plots": { "type": "array", "items": { "$ref": "#/$defs/plot" } },
        "porkchops": { "type": "array", "items": { "$ref": "#/$defs/porkchop" } },
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
        "conjunctions": { "type": "array", "items": { "$ref": "#/$defs/conjunction" } },
        "orbitDetermination": { "type": "array", "items": { "$ref": "#/$defs/orbitDetermination" } }
      }
    },
    "orbitDetermination": {
      "description": "Orbit determination of one spacecraft from TDM and/or simulated tracking.",
      "type": "object",
      "required": ["id", "spacecraft"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "letters, digits, - and _" },
        "label": { "type": "string" },
        "spacecraft": { "type": "string", "description": "Spacecraft id: the a priori; its propagation.covariance the a priori covariance (EKF: required)." },
        "estimator": { "enum": ["batch", "ekf"], "description": "Default batch." },
        "stations": { "type": "array", "items": { "type": "string" }, "description": "Ground station ids; default all." },
        "tdm": { "type": "string", "description": "CCSDS TDM (KVN) URL, relative to the app root, or data: URL." },
        "simulate": {
          "type": "object",
          "required": ["truth", "tracking"],
          "additionalProperties": false,
          "properties": {
            "truth": { "type": "string", "description": "Spacecraft id tracked." },
            "tracking": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type"],
                "additionalProperties": false,
                "properties": {
                  "type": { "enum": ["range", "rangeRate", "azimuth", "elevation", "rightAscension", "declination", "positionX", "positionY", "positionZ"] },
                  "station": { "type": "string", "description": "Ground station id; absent: every station." },
                  "sigma": { "type": "number", "minimum": 0, "description": "1σ noise and weight: km, km/s, deg." },
                  "bias": { "type": "number", "description": "km, km/s, deg." }
                }
              }
            },
            "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Default 60." },
            "seed": { "type": "integer", "minimum": 0 }
          }
        },
        "solveFor": {
          "type": "array",
          "description": "Batch only.",
          "items": {
            "type": "object",
            "required": ["parameter", "sigma"],
            "additionalProperties": false,
            "properties": {
              "parameter": { "enum": ["dragCoefficient", "reflectivity"] },
              "sigma": { "type": "number", "exclusiveMinimum": 0, "description": "A priori 1σ." }
            }
          }
        },
        "editSigma": { "type": "number", "minimum": 0, "description": "Batch: × RMS (default 3); EKF: innovation σ (default 5); 0 disables." },
        "lightTime": { "type": "boolean", "description": "Default true." }
      }
    },
    "conjunction": {
      "description": "Close-approach screening of one spacecraft against spacecraft and catalogue layers.",
      "type": "object",
      "required": ["id", "primary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "letters, digits, - and _" },
        "label": { "type": "string" },
        "primary": { "type": "string", "description": "Spacecraft id; its propagation.covariance feeds Pc." },
        "secondaries": { "type": "array", "items": { "type": "string" }, "description": "Spacecraft ids." },
        "layers": { "type": "array", "items": { "type": "string" }, "description": "Ephemeris layer ids: every object they hold." },
        "thresholdKm": { "type": "number", "exclusiveMinimum": 0, "description": "Default 5." },
        "hardBodyRadiusM": { "type": "number", "minimum": 0, "description": "Combined; default 20." },
        "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Search grid; default 60." },
        "secondarySigmaKm": {
          "$ref": "#/$defs/sigma3",
          "description": "RSW position 1σ for secondaries without a covariance (catalogue objects)."
        }
      }
    },
    "coverage": {
      "description": "Access coverage of an H3 grid by spacecraft.",
      "type": "object",
      "required": ["id", "spacecraft"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "title": "letters, digits, - and _" },
        "label": { "type": "string" },
        "spacecraft": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "access": {
          "enum": ["horizon", "sensors"],
          "description": "horizon: line of sight above minElevationDeg; sensors: inside an attitude sensor's fov too. Default horizon."
        },
        "minElevationDeg": { "type": "number", "minimum": -90, "exclusiveMaximum": 90, "description": "Default 0." },
        "resolution": { "type": "integer", "minimum": 0, "maximum": 7, "description": "H3; default 2." },
        "bounds": {
          "title": "[west, south, east, north] degrees",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": -180, "maximum": 360 },
          "description": "Default the globe; west > east crosses the antimeridian."
        },
        "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Default 60." },
        "metric": { "enum": ["fraction", "maxGap", "meanGap", "accesses"], "description": "Shaded on the globe; default fraction." },
        "show": { "type": "boolean", "description": "Drawn on the globe; one study at a time." }
      }
    },
    "plot": {
      "description": "One quantity against time for one or more spacecraft.",
      "type": "object",
      "required": ["id", "quantity", "spacecraft"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "quantity": {
          "enum": [
            "altitudeKm", "radiusKm", "speedKmS", "smaKm", "eccentricity", "inclinationDeg", "raanDeg",
            "argPerigeeDeg", "trueAnomalyDeg", "periodMin", "perigeeAltKm", "apogeeAltKm",
            "sigmaRadialM", "sigmaInTrackM", "sigmaCrossTrackM", "sigmaPositionM"
          ],
          "description": "src/reports.js PLOT_QUANTITIES; osculating two-body about Earth, altitudes over the equatorial radius; sigma* from propagation.covariance."
        },
        "spacecraft": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Spacecraft ids." }
      }
    },
    "porkchop": {
      "description": "Lambert total-Δv grid between two bodies.",
      "type": "object",
      "required": ["id", "origin", "destination", "departure", "arrival"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "origin": { "enum": ["Sun", "Earth", "Mars"] },
        "destination": { "enum": ["Sun", "Earth", "Mars"] },
        "departure": { "$ref": "#/$defs/dateRange" },
        "arrival": { "$ref": "#/$defs/dateRange" },
        "retrograde": { "type": "boolean", "description": "Long-way transfer; default false." },
        "steps": { "type": "integer", "minimum": 2, "maximum": 101, "description": "Grid steps per axis; default 33." }
      }
    },
    "dateRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time", "title": "an ISO 8601 date" },
        "end": { "type": "string", "format": "date-time", "title": "an ISO 8601 date" }
      }
    },
    "timeline": {
      "description": "Events on the clock; see src/timeline.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directed": { "type": "boolean", "description": "Apply event actions; default true." },
        "skipTo": {
          "$ref": "#/$defs/eventTime",
          "description": "Once known, a clock before it jumps forward to it (once per open)."
        },
        "events": { "type": "array", "items": {"$ref": "#/$defs/timelineEvent"} }
      }
    },
    "eventTime": {
      "title": "a date-time or {event, offsetS}",
      "anyOf": [
        { "type": "string", "format": "date-time" },
        {
          "type": "object",
          "required": ["event"],
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "string",
              "description": "<spacecraft>.start|end|burnN|finiteN|finiteN.end, <mission>.departure|escape|arrival|capture, or a timeline event id."
            },
            "offsetS": { "type": "number" }
          }
        }
      ]
    },
    "timelineEvent": {
      "type": "object",
      "required": ["id", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "title": "an id without dots", "type": "string", "pattern": "^[^.]+$" },
        "label": { "type": "string" },
        "at": { "$ref": "#/$defs/eventTime" },
        "actions": { "$ref": "#/$defs/actions" }
      }
    },
    "actions": {
      "description": "Applied while directed; see src/timeline.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeScale": {
          "anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "max"}],
          "description": "Magnitude; the clock keeps its direction."
        },
        "rampDoublingS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Doubles timeScale every this many wall-clock seconds, up to the maximum."
        },
        "paused": { "type": "boolean" },
        "view": { "enum": ["globe", "heliocentric"] },
        "frame": { "enum": ["ecef", "eci"] },
        "focus": {
          "type": "object",
          "required": ["layer"],
          "additionalProperties": false,
          "properties": {
            "layer": { "type": "string", "description": "Ephemeris layer or spacecraft id." },
            "noradId": { "type": "integer", "description": "Default: the layer's first object." }
          }
        },
        "follow": { "type": "string", "description": "Mission id; heliocentric camera lock." },
        "camera": {
          "type": "object",
          "required": ["lat", "lon"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number" },
            "altitudeKm": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "director": {
      "description": "Timeline preset; see src/director.js.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": {"enum": ["missionFlight"]} },
      "allOf": [
        {
          "if": { "properties": {"type": {"const": "missionFlight"}} },
          "then": { "$ref": "#/$defs/missionFlight" }
        }
      ]
    },
    "missionFlight": {
      "description": "Flies the clock and view through one mission.",
      "type": "object",
      "required": ["mission"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "missionFlight" },
        "mission": { "type": "string", "description": "Mission id." },
        "launchLeadSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "departureTimeScale": { "type": "number", "exclusiveMinimum": 0 },
        "departureDoublingSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "elements": {
      "description": "Osculating Keplerian elements, GCRF, EGM2008 GM.",
      "type": "object",
      "required": ["smaKm", "eccentricity", "inclinationDeg", "raanDeg", "argPerigeeDeg", "trueAnomalyDeg"],
      "additionalProperties": false,
      "properties": {
        "smaKm": { "type": "number", "exclusiveMinimum": 0 },
        "eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "inclinationDeg": { "type": "number", "minimum": 0, "maximum": 180 },
        "raanDeg": { "type": "number" },
        "argPerigeeDeg": { "type": "number" },
        "trueAnomalyDeg": { "type": "number" }
      }
    },
    "vector3": { "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3 },
    "spacecraft": {
      "description": "Display options as an ephemeris layer; propagation as globe propagate().",
      "type": "object",
      "required": ["id", "propagation"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Ephemeris layer id; unique across ephemerides and spacecraft."
        },
        "label": { "type": "string" },
        "visible": { "type": "boolean" },
        "trails": { "type": "boolean" },
        "leadingOrbits": { "type": "number", "minimum": 0 },
        "trailingOrbits": { "type": "number", "minimum": 0 },
        "trailSamples": { "type": "integer", "minimum": 0 },
        "trailPath": { "enum": ["track", "orbit"] },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" },
        "uncertaintySigma": {
          "type": "number",
          "minimum": 0,
          "description": "Position ellipsoid drawn at this many σ when propagation has a covariance; default 3, 0 hides."
        },
        "propagation": { "$ref": "#/$defs/propagation" },
        "sequence": {
          "description": "Mission sequence run from propagation's initial state; resolves its burns and stop (propagation then has none).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sequenceCommand" }
        }
      }
    },
    "propagation": {
      "description": "Cowell propagation; one of stop and durationS.",
      "type": "object",
      "required": ["initial"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "OEM OBJECT_NAME." },
        "objectId": { "type": "string", "description": "OEM OBJECT_ID; default name." },
        "naifId": { "type": "integer", "description": "SPK target; default -100900." },
        "initial": {
          "title": "a TLE ({tle}), an OMM ({omm}), a GCRF state ({epoch, positionKm, velocityKmS}) or elements ({epoch, elements})",
          "anyOf": [
            {
              "type": "object",
              "required": ["tle"],
              "additionalProperties": false,
              "properties": {
                "tle": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            {
              "type": "object",
              "required": ["omm"],
              "additionalProperties": false,
              "properties": { "omm": {"type": "object"} }
            },
            {
              "type": "object",
              "required": ["epoch", "positionKm", "velocityKmS"],
              "additionalProperties": false,
              "properties": {
                "epoch": { "type": "string", "format": "date-time" },
                "positionKm": { "$ref": "#/$defs/vector3" },
                "velocityKmS": { "$ref": "#/$defs/vector3" }
              }
            },
            {
              "type": "object",
              "required": ["epoch", "elements"],
              "additionalProperties": false,
              "properties": {
                "epoch": { "type": "string", "format": "date-time" },
                "elements": { "$ref": "#/$defs/elements" }
              }
            }
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "description": "Default: initial epoch."
        },
        "stop": { "type": "string", "format": "date-time" },
        "durationS": { "type": "number" },
        "stepS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Output step; default 60."
        },
        "vehicle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "massKg": { "type": "number", "exclusiveMinimum": 0 },
            "dryMassKg": { "type": "number", "minimum": 0 },
            "dragAreaM2": { "type": "number", "minimum": 0 },
            "dragCoefficient": { "type": "number", "minimum": 0 },
            "srpAreaM2": { "type": "number", "minimum": 0 },
            "reflectivity": { "type": "number", "minimum": 0 },
            "plates": {
              "description": "Flat plates, body axes, under the spacecraft's attitude profile: replace dragAreaM2, srpAreaM2, reflectivity.",
              "type": "array",
              "items": { "$ref": "#/$defs/plate" }
            }
          }
        },
        "forces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gravity": {
              "description": "[degree, order], EGM2008, ≤ 20; [0, 0] point mass.",
              "type": "array",
              "items": { "type": "integer", "minimum": 0, "maximum": 20 },
              "minItems": 2,
              "maxItems": 2
            },
            "thirdBody": { "type": "boolean" },
            "drag": { "enum": ["none", "exponential", "harrisPriester", "nrlmsise00"] },
            "srp": { "type": "boolean" },
            "relativity": { "type": "boolean" }
          }
        },
        "integrator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["dop853", "rkf78", "rk4"] },
            "relativeTolerance": { "type": "number", "exclusiveMinimum": 0 },
            "absoluteTolerance": { "type": "number", "exclusiveMinimum": 0 },
            "fixedStepS": { "type": "number", "exclusiveMinimum": 0, "description": "rk4 step." }
          }
        },
        "maneuvers": { "type": "array", "items": {"$ref": "#/$defs/maneuver"} },
        "finiteBurns": { "type": "array", "items": {"$ref": "#/$defs/finiteBurn"} },
        "covariance": { "$ref": "#/$defs/covariance" }
      }
    },
    "covariance": {
      "description": "Initial [r, v] covariance at the propagation start, propagated linearly through the state transition matrix.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["positionSigmaKm"] },
        { "required": ["velocitySigmaKmS"] },
        { "required": ["lowerTriangle"] }
      ],
      "title": "positionSigmaKm/velocitySigmaKmS or lowerTriangle",
      "properties": {
        "frame": {
          "enum": ["rsw", "ric", "rtn", "vnb", "lvlh", "inertial", "gcrf", "eci"],
          "description": "Axes of the sigmas, matrix and process noise; default rsw."
        },
        "positionSigmaKm": { "$ref": "#/$defs/sigma3", "description": "1σ per axis, km." },
        "velocitySigmaKmS": { "$ref": "#/$defs/sigma3", "description": "1σ per axis, km/s." },
        "lowerTriangle": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 21,
          "maxItems": 21,
          "description": "Row by row, km², km²/s, km²/s²; instead of sigmas."
        },
        "processNoiseKm2S3": { "$ref": "#/$defs/sigma3", "description": "White acceleration spectral density per axis, km²/s³." }
      }
    },
    "plate": {
      "type": "object",
      "required": ["normal", "areaM2"],
      "additionalProperties": false,
      "properties": {
        "normal": { "$ref": "#/$defs/vector3", "description": "Outward, body axes." },
        "areaM2": { "type": "number", "minimum": 0 },
        "specular": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0." },
        "diffuse": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0; absorbed 1 − specular − diffuse." }
      }
    },
    "sigma3": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 3, "maxItems": 3 },
    "maneuver": {
      "description": "Impulsive.",
      "type": "object",
      "required": ["epoch", "deltaVKmS"],
      "additionalProperties": false,
      "properties": {
        "epoch": { "type": "string", "format": "date-time" },
        "deltaVKmS": { "$ref": "#/$defs/vector3" },
        "frame": {
          "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci"],
          "description": "Default vnb."
        },
        "ispS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mass from the rocket equation; omitted: mass unchanged."
        }
      }
    },
    "finiteBurn": {
      "type": "object",
      "required": ["start", "durationS", "thrustN", "ispS", "direction"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "durationS": { "type": "number", "exclusiveMinimum": 0 },
        "thrustN": { "type": "number", "exclusiveMinimum": 0 },
        "ispS": { "type": "number", "exclusiveMinimum": 0 },
        "direction": { "$ref": "#/$defs/vector3" },
        "frame": {
          "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci", "body"],
          "description": "Default vnb; body: body axes under the spacecraft's attitude profile."
        }
      }
    },
    "quantity": {
      "description": "Osculating, two-body about Earth (EGM2008 GM), GCRF; altitudes above the equatorial radius.",
      "type": "string",
      "enum": ["altitudeKm", "radiusKm", "speedKmS", "radialVelocityKmS", "smaKm", "eccentricity", "inclinationDeg", "raanDeg", "argPerigeeDeg", "trueAnomalyDeg", "argLatitudeDeg", "latitudeDeg", "periodMin", "perigeeAltKm", "apogeeAltKm", "flightPathAngleDeg", "massKg"]
    },
    "sequenceCommand": {
      "description": "Optional label and exactly one action.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "propagate": { "$ref": "#/$defs/sequencePropagate" },
        "maneuver": { "$ref": "#/$defs/sequenceManeuver" },
        "finiteBurn": { "$ref": "#/$defs/sequenceFiniteBurn" },
        "target": { "$ref": "#/$defs/sequenceTarget" }
      }
    },
    "sequencePropagate": {
      "description": "Exactly one of durationS, epoch, to, quantity (+ value).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationS": { "type": "number", "minimum": 0 },
        "epoch": { "type": "string", "format": "date-time" },
        "to": { "enum": ["periapsis", "apoapsis", "ascendingNode", "descendingNode"] },
        "quantity": { "$ref": "#/$defs/quantity" },
        "value": { "type": "number" },
        "direction": { "enum": ["increasing", "decreasing", "either"], "description": "Default either." },
        "count": { "type": "integer", "minimum": 1, "description": "Crossing occurrence; default 1." },
        "stepS": { "type": "number", "exclusiveMinimum": 0, "description": "Crossing bracket step; default 60." },
        "maxDurationS": { "type": "number", "exclusiveMinimum": 0, "description": "Crossing search limit; default 30 days." }
      }
    },
    "sequenceManeuver": {
      "description": "Impulsive, at the current epoch.",
      "type": "object",
      "required": ["deltaVKmS"],
      "additionalProperties": false,
      "properties": {
        "deltaVKmS": { "$ref": "#/$defs/vector3" },
        "frame": { "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci"], "description": "Default vnb." },
        "ispS": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sequenceFiniteBurn": {
      "description": "From the current epoch.",
      "type": "object",
      "required": ["durationS", "thrustN", "ispS", "direction"],
      "additionalProperties": false,
      "properties": {
        "durationS": { "type": "number", "minimum": 0 },
        "thrustN": { "type": "number", "exclusiveMinimum": 0 },
        "ispS": { "type": "number", "exclusiveMinimum": 0 },
        "direction": { "$ref": "#/$defs/vector3" },
        "frame": { "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci", "body"], "description": "Default vnb; body: under the attitude profile." }
      }
    },
    "sequenceTarget": {
      "description": "Varies labelled commands in sequence until goals hold at its end.",
      "type": "object",
      "required": ["variables", "goals", "sequence"],
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "parameter"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "description": "Label in this target's sequence." },
              "parameter": { "enum": ["dv1", "dv2", "dv3", "durationS"], "description": "dv: maneuver km/s in its frame; durationS: finite burn or durationS propagate." },
              "perturbation": { "type": "number", "exclusiveMinimum": 0, "description": "Default 1e-5 km/s or 1 s." },
              "maxStep": { "type": "number", "exclusiveMinimum": 0, "description": "Default 0.5 km/s or 600 s." }
            }
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["quantity", "value", "tolerance"],
            "additionalProperties": false,
            "properties": {
              "quantity": { "$ref": "#/$defs/quantity" },
              "value": { "type": "number" },
              "tolerance": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "sequence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sequenceCommand" } },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 200, "description": "Default 25." }
      }
    }
  }
}
