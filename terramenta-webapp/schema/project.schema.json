{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terramenta project",
  "description": "*.terramenta.json, format version 2. Omitted fields keep fresh-globe defaults. Relative URLs resolve against the app root. Cross-references (ids, mission names, stop/durationS) are checked by src/project.js.",
  "type": "object",
  "required": ["terramenta"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "terramenta": { "const": 2, "description": "Format version." },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": { "enum": ["full", "flight"] },
        "tab": {
          "enum": ["project", "imagery", "data", "spacecraft", "timeline", "other", "mission"]
        },
        "readout": { "type": "boolean" },
        "collapsed": { "type": "boolean" }
      }
    },
    "view": { "enum": ["globe", "heliocentric"] },
    "frame": { "enum": ["ecef", "eci"] },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": { "anyOf": [{"const": "now"}, {"type": "string", "format": "date-time"}] },
        "timeScale": { "type": "number" },
        "paused": { "type": "boolean" },
        "shaded": { "type": "boolean" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "description": "lat and lon go together; follow and anchor are exclusive.",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number" },
        "altitudeKm": { "type": "number", "exclusiveMinimum": 0 },
        "follow": { "type": "string", "description": "Mission id." },
        "anchor": { "enum": ["sun", "earth", "mars", "barycenter"] }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": {"type": "boolean"}, "layer": {"$ref": "#/$defs/preset"} }
    },
    "vectorTiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "layer": { "$ref": "#/$defs/preset" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "picking": { "type": "boolean" },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/overlayLayer"} }
      }
    },
    "ephemerides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/ephemerisLayer"} }
      }
    },
    "environment": {
      "description": "Propagation data, by URL. Loaded once per session; see src/environment.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eop": { "type": "string", "description": "IERS finals2000A.all or CelesTrak EOP-All.csv." },
        "spaceWeather": {
          "type": "string",
          "description": "CelesTrak SW-All.csv; needed by drag nrlmsise00."
        },
        "kernel": {
          "type": "string",
          "description": "SPK/PCK, e.g. de440s.bsp; Sun/Moon third body."
        }
      }
    },
    "spacecraft": {
      "description": "Numerically propagated spacecraft, drawn as ephemeris layers.",
      "type": "array",
      "items": { "$ref": "#/$defs/spacecraft" }
    },
    "missions": { "type": "array", "items": {"$ref": "#/$defs/mission"} },
    "placemarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": {"type": "boolean"} }
    },
    "gnc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "eciAxes": { "type": "boolean" },
        "ecefAxes": { "type": "boolean" },
        "graticule": { "type": "boolean" },
        "graticuleStepDeg": { "type": "number", "exclusiveMinimum": 0 },
        "sidereal": { "type": "boolean" },
        "track": { "type": "boolean" },
        "trackOrbits": { "type": "number", "minimum": 0 },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "noradId"],
          "properties": {
            "layer": { "type": "string", "description": "Ephemeris layer id." },
            "noradId": { "type": "integer" }
          }
        }
      }
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "visible": {"type": "boolean"}, "help": {"type": "boolean"} }
    },
    "keyboard": { "type": "boolean" },
    "director": { "$ref": "#/$defs/director" },
    "timeline": { "$ref": "#/$defs/timeline" }
  },
  "$defs": {
    "color": {
      "title": "a hex colour (#rgb, #rgba, #rrggbb, #rrggbbaa)",
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "preset": {
      "description": "Preset label or index.",
      "anyOf": [{"type": "string"}, {"type": "integer", "minimum": 0}]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "refreshSeconds": {
      "description": "Re-fetch period; null: never.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "overlayLayer": {
      "description": "GeoJSON. Exactly one of url and text.",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "refreshSeconds": { "$ref": "#/$defs/refreshSeconds" },
        "visible": { "type": "boolean" },
        "simpleStyle": { "type": "boolean" },
        "altitudeMode": { "enum": ["relativeToSurface", "clampToSurface"] },
        "altitudeScale": { "type": "number" },
        "extrude": { "type": "boolean" },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "ephemerisLayer": {
      "description": "OMM JSON or KVN OEM. Exactly one of url and text.",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "refreshSeconds": { "$ref": "#/$defs/refreshSeconds" },
        "visible": { "type": "boolean" },
        "select": {
          "description": "NORAD ids drawn; null or omitted: all.",
          "type": ["array", "null"],
          "items": { "type": "integer" }
        },
        "trails": { "type": "boolean" },
        "leadingOrbits": { "type": "number", "minimum": 0 },
        "trailingOrbits": { "type": "number", "minimum": 0 },
        "trailSamples": { "type": "integer", "minimum": 0 },
        "trailPath": { "enum": ["track", "orbit"] },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" }
      }
    },
    "mission": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "departureSearchDays": { "type": "number", "exclusiveMinimum": 0 },
        "arrivalSearchStartDays": { "type": "number", "minimum": 0 },
        "arrivalSearchEndDays": { "type": "number", "exclusiveMinimum": 0 },
        "searchSteps": { "type": "integer", "minimum": 1 },
        "parkingAltitudeKm": { "type": "number", "minimum": 0 }
      }
    },
    "timeline": {
      "description": "Events on the clock; see src/timeline.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directed": { "type": "boolean", "description": "Apply event actions; default true." },
        "skipTo": {
          "$ref": "#/$defs/eventTime",
          "description": "Once known, a clock before it jumps forward to it (once per open)."
        },
        "events": { "type": "array", "items": {"$ref": "#/$defs/timelineEvent"} }
      }
    },
    "eventTime": {
      "title": "a date-time or {event, offsetS}",
      "anyOf": [
        { "type": "string", "format": "date-time" },
        {
          "type": "object",
          "required": ["event"],
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "string",
              "description": "<spacecraft>.start|end|burnN|finiteN|finiteN.end, <mission>.departure|escape|arrival|capture, or a timeline event id."
            },
            "offsetS": { "type": "number" }
          }
        }
      ]
    },
    "timelineEvent": {
      "type": "object",
      "required": ["id", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "title": "an id without dots", "type": "string", "pattern": "^[^.]+$" },
        "label": { "type": "string" },
        "at": { "$ref": "#/$defs/eventTime" },
        "actions": { "$ref": "#/$defs/actions" }
      }
    },
    "actions": {
      "description": "Applied while directed; see src/timeline.js.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeScale": {
          "anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "max"}],
          "description": "Magnitude; the clock keeps its direction."
        },
        "rampDoublingS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Doubles timeScale every this many wall-clock seconds, up to the maximum."
        },
        "paused": { "type": "boolean" },
        "view": { "enum": ["globe", "heliocentric"] },
        "frame": { "enum": ["ecef", "eci"] },
        "focus": {
          "type": "object",
          "required": ["layer"],
          "additionalProperties": false,
          "properties": {
            "layer": { "type": "string", "description": "Ephemeris layer or spacecraft id." },
            "noradId": { "type": "integer", "description": "Default: the layer's first object." }
          }
        },
        "follow": { "type": "string", "description": "Mission id; heliocentric camera lock." },
        "camera": {
          "type": "object",
          "required": ["lat", "lon"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number" },
            "altitudeKm": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "director": {
      "description": "Timeline preset; see src/director.js.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": {"enum": ["missionFlight"]} },
      "allOf": [
        {
          "if": { "properties": {"type": {"const": "missionFlight"}} },
          "then": { "$ref": "#/$defs/missionFlight" }
        }
      ]
    },
    "missionFlight": {
      "description": "Flies the clock and view through one mission.",
      "type": "object",
      "required": ["mission"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "missionFlight" },
        "mission": { "type": "string", "description": "Mission id." },
        "launchLeadSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "departureTimeScale": { "type": "number", "exclusiveMinimum": 0 },
        "departureDoublingSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "vector3": { "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3 },
    "spacecraft": {
      "description": "Display options as an ephemeris layer; propagation as globe propagate().",
      "type": "object",
      "required": ["id", "propagation"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Ephemeris layer id; unique across ephemerides and spacecraft."
        },
        "label": { "type": "string" },
        "visible": { "type": "boolean" },
        "trails": { "type": "boolean" },
        "leadingOrbits": { "type": "number", "minimum": 0 },
        "trailingOrbits": { "type": "number", "minimum": 0 },
        "trailSamples": { "type": "integer", "minimum": 0 },
        "trailPath": { "enum": ["track", "orbit"] },
        "pointColor": { "$ref": "#/$defs/color" },
        "pointSizePx": { "type": "number", "minimum": 0 },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidthPx": { "type": "number", "minimum": 0 },
        "fillColor": { "$ref": "#/$defs/color" },
        "propagation": { "$ref": "#/$defs/propagation" }
      }
    },
    "propagation": {
      "description": "Cowell propagation; one of stop and durationS.",
      "type": "object",
      "required": ["initial"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "OEM OBJECT_NAME." },
        "objectId": { "type": "string", "description": "OEM OBJECT_ID; default name." },
        "naifId": { "type": "integer", "description": "SPK target; default -100900." },
        "initial": {
          "title": "a TLE ({tle}), an OMM ({omm}) or a GCRF state ({epoch, positionKm, velocityKmS})",
          "anyOf": [
            {
              "type": "object",
              "required": ["tle"],
              "additionalProperties": false,
              "properties": {
                "tle": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            {
              "type": "object",
              "required": ["omm"],
              "additionalProperties": false,
              "properties": { "omm": {"type": "object"} }
            },
            {
              "type": "object",
              "required": ["epoch", "positionKm", "velocityKmS"],
              "additionalProperties": false,
              "properties": {
                "epoch": { "type": "string", "format": "date-time" },
                "positionKm": { "$ref": "#/$defs/vector3" },
                "velocityKmS": { "$ref": "#/$defs/vector3" }
              }
            }
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "description": "Default: initial epoch."
        },
        "stop": { "type": "string", "format": "date-time" },
        "durationS": { "type": "number" },
        "stepS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Output step; default 60."
        },
        "vehicle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "massKg": { "type": "number", "exclusiveMinimum": 0 },
            "dryMassKg": { "type": "number", "minimum": 0 },
            "dragAreaM2": { "type": "number", "minimum": 0 },
            "dragCoefficient": { "type": "number", "minimum": 0 },
            "srpAreaM2": { "type": "number", "minimum": 0 },
            "reflectivity": { "type": "number", "minimum": 0 }
          }
        },
        "forces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gravity": {
              "description": "[degree, order], EGM2008, ≤ 20; [0, 0] point mass.",
              "type": "array",
              "items": { "type": "integer", "minimum": 0, "maximum": 20 },
              "minItems": 2,
              "maxItems": 2
            },
            "thirdBody": { "type": "boolean" },
            "drag": { "enum": ["none", "exponential", "harrisPriester", "nrlmsise00"] },
            "srp": { "type": "boolean" },
            "relativity": { "type": "boolean" }
          }
        },
        "integrator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["dop853", "rkf78", "rk4"] },
            "relativeTolerance": { "type": "number", "exclusiveMinimum": 0 },
            "absoluteTolerance": { "type": "number", "exclusiveMinimum": 0 },
            "fixedStepS": { "type": "number", "exclusiveMinimum": 0, "description": "rk4 step." }
          }
        },
        "maneuvers": { "type": "array", "items": {"$ref": "#/$defs/maneuver"} },
        "finiteBurns": { "type": "array", "items": {"$ref": "#/$defs/finiteBurn"} }
      }
    },
    "maneuver": {
      "description": "Impulsive.",
      "type": "object",
      "required": ["epoch", "deltaVKmS"],
      "additionalProperties": false,
      "properties": {
        "epoch": { "type": "string", "format": "date-time" },
        "deltaVKmS": { "$ref": "#/$defs/vector3" },
        "frame": {
          "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci"],
          "description": "Default vnb."
        },
        "ispS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mass from the rocket equation; omitted: mass unchanged."
        }
      }
    },
    "finiteBurn": {
      "type": "object",
      "required": ["start", "durationS", "thrustN", "ispS", "direction"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "durationS": { "type": "number", "exclusiveMinimum": 0 },
        "thrustN": { "type": "number", "exclusiveMinimum": 0 },
        "ispS": { "type": "number", "exclusiveMinimum": 0 },
        "direction": { "$ref": "#/$defs/vector3" },
        "frame": {
          "enum": ["vnb", "rsw", "ric", "lvlh", "inertial", "gcrf", "eci"],
          "description": "Default vnb."
        }
      }
    }
  }
}
